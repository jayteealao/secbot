// Test-cell deployment: the person-cell routes plus ConformanceCell. Never deployed to a person cell.
// The vars are names only: secbot-release fills them on the VPS at deploy time.
{
  "name": "secbot",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "CONFORMANCE", "class_name": "ConformanceCell" },
      { "name": "PERSON_CELL", "class_name": "PersonCell" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ConformanceCell"] },
    { "tag": "v2", "new_sqlite_classes": ["PersonCell"] }
  ],
  "vars": {
    "OPENROUTER_API_KEY": "",
    "BETTERSTACK_INCIDENTS_TOKEN": "",
    "BETTERSTACK_REQUESTER_EMAIL": "",
    "SECBOT_DEVICE_KEYS": "",
    "SECBOT_PRIVATE_HOSTS": ""
  }
}
