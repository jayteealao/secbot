#!/usr/bin/env bash
# secbot-release: the only command the deploy and deploy-test users can run over SSH.
# authorized_keys forces it: command="/usr/local/bin/secbot-release <user>",restrict
# The client's request arrives in SSH_ORIGINAL_COMMAND and is parsed here, never run by a shell.
#
#   stage         --version V --sha256 S          bundle on stdin; kept only if its SHA-256 is S
#   deploy        --env E --version V [--sha256 S] [--cells C] [--run-id R --run-attempt A]
#                                                  deploy a staged bundle to the fleets of the cells
#   conformance   --version V [--long-transaction] deploy V to the test cell, run the in-cell suite
#   manifest      --env E                          print the deployed manifest (each fleet)
#   health        --env E [--cells C]              print the cell health (version, and each named cell)
#   alarms        --env E [--cells C]              print each cell's stored alarm against its earliest timer
#   heartbeats    [--env E] [--cells C]            each cell's last heartbeat and its fleet's deploy time
#                                                  (the secrets cell keeps no heartbeat here)
#   snapshot      --env E --snapshot-id ID         every cell of the environment to its fleet bucket
#                                                  (never the secrets cell: printed as skipped)
#   restore       --env E --cells CELL --snapshot ID  load one cell from its snapshot (never secrets)
#   digest        --env E [--cells C]              each cell's database digest (never secrets)
#   drill         [--snapshot ID] [--cells C]      copy a production snapshot into the test cell, restore it
#   ledger-record --kind K [--version V] [--cells C] [--snapshot-id ID] [--run-id R --run-attempt A]
#   ledger-read                                    print the deploy ledger (JSON lines)
#   lease         acquire|release --holder H [--seconds N]  hold the VPS lock across several commands
#   state         --env E|all                      celld's /state of each fleet (memory, isolates)
#   write-delay   --env test-cell --writes N       time N single-row committed writes (ms each)
#   lab           --env test-cell --route R [--at T] [--calls N | --examples [--repeat R]]
#                 [--adapter A]                    call the test cell's durability lab, or its guard
#                                                  bench (routes guard-bench and guard-bench-state);
#                                                  --examples runs the decision-model examples
#   crash         --env test-cell                  SIGKILL celld@test, wait until it answers again
#   down          --env test-cell --seconds N      stop celld@test for N seconds, start it, wait for it
#   tool-sha                                       this tool's SHA-256, so a client sees a stale copy
#
# Fleets: celld runs one application per fleet (celld v0.6.1 README, "A fleet runs one
# application"), so each rollout stage is its own fleet. The test cell is one fleet (celld@test)
# that serves every cell. Production is celld@prod-owner (the owner cell) and celld@prod-shared
# (the second person's cell, the household cell, and the secrets cell); both share the production
# bucket by key prefix. Cell names follow the release workflows: `person` is the second person's
# cell. The secrets cell's master keys stay with the host key helper (secbot-key-helper@<env>):
# this tool never reads a key file; it fills only the helper's loopback address into the fleet
# that serves the secrets cell.
#
# crash and down use exactly three sudo commands for celld@test (sudoers drop-in from host setup);
# nothing here can stop, kill, or start a production unit.
#
# A deploy fills the worker config's runtime vars (the OpenRouter key, the Better Stack incidents
# token and e-mail, the device keys, the private host names, the heartbeat ping URLs and time
# zone, and the operator key) from /etc/secbot on this host into a temporary copy, because celld
# deploy has no secret mechanism; the values never enter the repo, the bundle, CI, or this tool's
# output. The operator key also gates the cells' operator routes; this tool sends it from a
# private header file, never on a command line.
#
# Every command that changes the release store or a cell holds one lock for its whole run, so a
# release, a rollback, a restore, and a development test run never overlap. A multi-step run takes
# a lease first; while another holder's lease is live, every locking command waits for it.
set -euo pipefail
umask 027

caller="${1:-}"
STATE=/var/lib/secbot
RELEASES="$STATE/releases"
DEPLOYS="$STATE/deploy"
LOCK="$STATE/deploy.lock"
LEASE="$STATE/lease"
LEDGER="$STATE/ledger.jsonl"
DRILL_DIRTY="$STATE/drill-dirty"
DRILL_OBJECTS="$STATE/drill-objects"
SNAPSHOT_BUCKET=secbot-snapshots
KNOWN="$RELEASES/known-sha256"
KEEP=5
WAIT_SECONDS=1800
MAX_BUNDLE_BYTES=209715200

die() { echo "secbot-release: $*" >&2; exit 1; }

case "$caller" in
  deploy-test) allowed_envs="test-cell" ;;
  deploy) allowed_envs="test-cell production" ;;
  *) die "unknown caller '$caller'" ;;
esac

read -r -a argv <<<"${SSH_ORIGINAL_COMMAND:-}"
[ "${#argv[@]}" -gt 0 ] || die "no command; expected tool-sha, stage, deploy, conformance, manifest, health, alarms, heartbeats, snapshot, restore, digest, drill, ledger-record, ledger-read, lease, state, write-delay, lab, crash, or down"
command="${argv[0]}"
action=""
i=1
if [ "$command" = "lease" ]; then action="${argv[1]:-}"; i=2; fi
version="" sha256="" env="" long_transaction=0 cells="" lab_route="" at="" seconds=""
snapshot_id="" kind="" run_id="" run_attempt="" holder="" writes="" calls="" adapter=""
examples=0 repeat=""
while [ "$i" -lt "${#argv[@]}" ]; do
  flag="${argv[$i]}"
  value="${argv[$((i + 1))]:-}"
  case "$flag" in
    --version) version="$value"; i=$((i + 2)) ;;
    --sha256) sha256="$value"; i=$((i + 2)) ;;
    --env) env="$value"; i=$((i + 2)) ;;
    --long-transaction) long_transaction=1; i=$((i + 1)) ;;
    --cells) cells="$value"; i=$((i + 2)) ;;
    --route) lab_route="$value"; i=$((i + 2)) ;;
    --at) at="$value"; i=$((i + 2)) ;;
    --seconds) seconds="$value"; i=$((i + 2)) ;;
    --snapshot-id | --snapshot) snapshot_id="$value"; i=$((i + 2)) ;;
    --kind) kind="$value"; i=$((i + 2)) ;;
    --run-id) run_id="$value"; i=$((i + 2)) ;;
    --run-attempt) run_attempt="$value"; i=$((i + 2)) ;;
    --holder) holder="$value"; i=$((i + 2)) ;;
    --writes) writes="$value"; i=$((i + 2)) ;;
    --calls) calls="$value"; i=$((i + 2)) ;;
    --adapter) adapter="$value"; i=$((i + 2)) ;;
    --examples) examples=1; i=$((i + 1)) ;;
    --repeat) repeat="$value"; i=$((i + 2)) ;;
    *) die "unknown argument '$flag'" ;;
  esac
done

[ -z "$version" ] || [[ "$version" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.-]+)?$ ]] || die "bad version '$version'"
[ -z "$sha256" ] || [[ "$sha256" =~ ^[0-9a-f]{64}$ ]] || die "bad sha256"
[ -z "$env" ] || [ "$env" = "all" ] || [[ " $allowed_envs " == *" $env "* ]] || die "$caller may not use environment '$env'"
[ -z "$cells" ] || [[ "$cells" =~ ^[a-z][a-z0-9,-]*$ ]] || die "bad cells '$cells'"
[ -z "$lab_route" ] || [[ "$lab_route" =~ ^(arm|state|alarm-report|household-roundtrip|rearm|alarm|load|load-state|guard-bench|guard-bench-state)$ ]] || die "bad lab route '$lab_route'"
[ -z "$at" ] || [[ "$at" =~ ^([0-9]{13}|none)$ ]] || die "bad --at '$at'"
[ -z "$seconds" ] || [[ "$seconds" =~ ^[0-9]{1,5}$ ]] || die "bad --seconds '$seconds'"
[ -z "$snapshot_id" ] || [[ "$snapshot_id" =~ ^[A-Za-z0-9._-]{1,100}$ ]] || die "bad snapshot id '$snapshot_id'"
[ -z "$kind" ] || [[ "$kind" =~ ^(release|rollback|restore)$ ]] || die "bad kind '$kind'"
[ -z "$run_id" ] || [[ "$run_id" =~ ^[0-9]{1,20}$ ]] || die "bad run id"
[ -z "$run_attempt" ] || [[ "$run_attempt" =~ ^[0-9]{1,4}$ ]] || die "bad run attempt"
[ -z "$holder" ] || [[ "$holder" =~ ^[A-Za-z0-9._:-]{1,80}$ ]] || die "bad holder '$holder'"
[ -z "$writes" ] || [[ "$writes" =~ ^[0-9]{1,4}$ ]] || die "bad --writes '$writes'"
[ -z "$calls" ] || [[ "$calls" =~ ^[0-9]{1,3}$ ]] || die "bad --calls '$calls'"
[ -z "$adapter" ] || [[ "$adapter" =~ ^(clef|clef-flash|jev)$ ]] || die "bad --adapter '$adapter'"
[ -z "$repeat" ] || [[ "$repeat" =~ ^[1-3]$ ]] || die "bad --repeat '$repeat'"
[ -z "$repeat" ] || [ "$examples" = 1 ] || die "--repeat needs --examples"
[ "$examples" = 0 ] || [ -z "$calls" ] || die "send --calls or --examples, not both"
[ "$examples" = 0 ] || [ "$lab_route" = guard-bench ] || die "--examples needs --route guard-bench"

# ---- fleets and cells --------------------------------------------------------------------------

fleets_of_env() {
  case "$1" in
    test-cell) echo "test" ;;
    production) echo "prod-owner prod-shared" ;;
    all) echo "test prod-owner prod-shared" ;;
  esac
}
env_of_fleet() { [ "$1" = test ] && echo test-cell || echo production; }
fleet_cells() {
  case "$1" in
    test) echo "owner second household secrets" ;;
    prod-owner) echo "owner" ;;
    prod-shared) echo "second household secrets" ;;
  esac
}
# The deploy directory keeps the test cell's earlier name, so its deploy history stays readable.
fleet_dir() { [ "$1" = test ] && echo "$DEPLOYS/test-cell" || echo "$DEPLOYS/$1"; }
fleet_of_cell() {
  local target_env="$1" cell="$2" fleet
  for fleet in $(fleets_of_env "$target_env"); do
    [[ " $(fleet_cells "$fleet") " == *" $cell "* ]] && { echo "$fleet"; return 0; }
  done
  return 1
}

# The workflow names to the cells' own: person is the second person.
normalized_cells() {
  local name out=""
  for name in ${1//,/ }; do
    case "$name" in
      person) name=second ;;
    esac
    [[ " $out " == *" $name "* ]] || out="$out $name"
  done
  echo "${out# }"
}

# The fleets that serve the named cells (every fleet of the environment without names).
fleets_for() {
  local target_env="$1" list="$2" fleets="" cell fleet
  if [ -z "$list" ]; then fleets_of_env "$target_env"; return; fi
  for cell in $(normalized_cells "$list"); do
    [ "$cell" = lab ] && [ "$target_env" = test-cell ] && cell=owner
    fleet="$(fleet_of_cell "$target_env" "$cell")" || die "no fleet of $target_env serves cell '$cell'"
    [[ " $fleets " == *" $fleet "* ]] || fleets="$fleets $fleet"
  done
  echo "${fleets# }"
}

# The named cells this fleet serves, comma separated (every served cell without names).
cells_in_fleet() {
  local fleet="$1" list="$2" out="" cell
  if [ -z "$list" ]; then
    out="$(fleet_cells "$fleet")"
  else
    for cell in $(normalized_cells "$list" 2>/dev/null); do
      if [[ " $(fleet_cells "$fleet") " == *" $cell "* ]] || { [ "$cell" = lab ] && [ "$fleet" = test ]; }; then
        out="$out $cell"
      fi
    done
  fi
  out="${out# }"
  echo "${out// /,}"
}

# cells_in_fleet without the secrets cell, for the routes that never take it (heartbeats, digest).
data_cells_in_fleet() {
  local list
  list="$(cells_in_fleet "$1" "$2")"
  list=",$list,"
  list="${list//,secrets,/,}"
  list="${list#,}"
  echo "${list%,}"
}

# ---- the VPS lock and the lease ----------------------------------------------------------------

lease_read() {
  if [ -f "$LEASE" ]; then cat "$LEASE" || true; fi
}

# True when no other holder's lease is live.
lease_free() {
  local record lease_holder until
  record="$(lease_read)"
  [ -n "$record" ] || return 0
  read -r lease_holder until <<<"$record"
  [ "$(date +%s)" -ge "${until:-0}" ] && return 0
  [ -n "$holder" ] && [ "$holder" = "$lease_holder" ]
}

with_lock() {
  exec 9<"$LOCK"
  local deadline=$(( $(date +%s) + WAIT_SECONDS ))
  while :; do
    flock -w "$WAIT_SECONDS" 9 || die "the VPS deploy lock is busy"
    lease_free && return 0
    flock -u 9
    if [ "$(date +%s)" -ge "$deadline" ]; then
      local lease_holder until
      read -r lease_holder until <<<"$(lease_read)"
      die "the VPS lock is held by $lease_holder until $(date -u -d "@$until" +%Y-%m-%dT%H:%M:%SZ)"
    fi
    sleep 10
  done
}

do_lease() {
  [ -n "$holder" ] || die "lease needs --holder"
  case "$action" in
    acquire)
      local ttl="${seconds:-3600}" max=14400
      # The test-cell key holds the lock at most an hour, so it cannot keep a rollback waiting.
      [ "$caller" = deploy ] || max=3600
      if ! { [ "$ttl" -ge 60 ] && [ "$ttl" -le "$max" ]; }; then die "lease --seconds must be 60-$max"; fi
      with_lock
      echo "$holder $(( $(date +%s) + ttl ))" >"$LEASE"
      echo "lease acquired by $holder for $ttl s"
      ;;
    release)
      exec 9<"$LOCK"
      flock -w "$WAIT_SECONDS" 9 || die "the VPS deploy lock is busy"
      local lease_holder until
      read -r lease_holder until <<<"$(lease_read)"
      if [ "${lease_holder:-}" = "$holder" ]; then rm -f "$LEASE"; echo "lease released by $holder"; else echo "lease: $holder holds no lease"; fi
      ;;
    *) die "lease needs acquire or release" ;;
  esac
}

# ---- environment files and the operator key ---------------------------------------------------

# Sources one fleet's celld settings (bucket, endpoint, listeners, bucket credentials).
fleet_file() {
  local file="/etc/secbot/fleet-$1.env"
  [ -r "$file" ] || die "fleet '$1' is not set up on this host ($file is missing)"
  set -a
  # The fleet's settings file, written by Ansible from the owner's environment; its path is a variable.
  # shellcheck source=/dev/null
  . "$file"
  set +a
  : "${CELLD_BUCKET:?}" "${CELLD_ENDPOINT:?}" "${CELLD_LISTEN:?}" "${CELLD_INTERNAL_PORT:?}"
}

# Prints a fleet's worker listener (host:port) without changing this shell.
listen_of() { ( fleet_file "$1"; echo "$CELLD_LISTEN" ); }

operator_key_file() { echo "/etc/secbot/$1-operator.key"; }

# Writes a private curl header file with the operator key; prints its path.
operator_header() {
  local file key header
  file="$(operator_key_file "$1")"
  [ -r "$file" ] || die "the operator key for $1 is missing ($file); run host setup"
  key="$(cat "$file")"
  header="$(mktemp)"
  printf 'x-secbot-operator: %s\n' "$key" >"$header"
  echo "$header"
}

# curl to a fleet's operator route with the operator key; prints the body.
ops_call() {
  local fleet="$1" method="$2" path="$3" header status
  header="$(operator_header "$(env_of_fleet "$fleet")")"
  local body
  body="$(mktemp)"
  status="$(curl -sS --max-time 600 -o "$body" -w '%{http_code}' -X "$method" -H "@$header" "http://$(listen_of "$fleet")$path")" || status=000
  rm -f "$header"
  cat "$body"
  rm -f "$body"
  echo
  if ! { [ "$status" -ge 200 ] && [ "$status" -lt 300 ]; }; then
    echo "secbot-release: $method $path on $fleet answered $status" >&2
    return 1
  fi
}

# Runtime vars the worker config declares with empty values; each must be set for a deploy.
RUNTIME_VARS="OPENROUTER_API_KEY BETTERSTACK_INCIDENTS_TOKEN BETTERSTACK_REQUESTER_EMAIL SECBOT_DEVICE_KEYS SECBOT_PRIVATE_HOSTS"
# Runtime vars a deploy fills when the settings file has them; they stay empty otherwise.
OPTIONAL_RUNTIME_VARS="SECBOT_HEARTBEAT_URLS SECBOT_TIME_ZONE"

# Copies the app to a private temporary directory and fills its runtime vars; prints the copy's path.
# Names a missing or unsafe setting, never its value.
render_app() {
  local target_env="$1" fleet="$2" app="$3"
  local file="/etc/secbot/$target_env-runtime.env"
  [ -r "$file" ] || die "runtime settings for $target_env are missing ($file); run host setup with the runtime values in your shell"
  local key_file
  key_file="$(operator_key_file "$target_env")"
  [ -r "$key_file" ] || die "the operator key for $target_env is missing ($key_file); run host setup"
  local fleet_cells_value="" household_url="" secrets_url="" serves_secrets=""
  # The test cell's single fleet serves every cell: SECBOT_FLEET_CELLS stays empty there.
  [ "$fleet" = test ] || fleet_cells_value="$(cells_in_fleet "$fleet" "")"
  household_url="http://$(listen_of "$(fleet_of_cell "$target_env" household)")"
  secrets_url="http://$(listen_of "$(fleet_of_cell "$target_env" secrets)")"
  # The key helper's loopback address goes only to the fleet that serves the secrets cell.
  [[ " $(fleet_cells "$fleet") " == *" secrets "* ]] && serves_secrets=1
  # Without its key helper the secrets cell refuses to start and every cell check after the
  # deploy fails; stop here instead, with the step that fixes it.
  if [ -n "$serves_secrets" ] && ! /usr/bin/systemctl is-active --quiet "secbot-key-helper@$target_env"; then
    die "the secrets cell's key helper (secbot-key-helper@$target_env) is not running; run host setup (mise run host:setup) before this release"
  fi
  local copy
  copy="$(mktemp -d)"
  cp -a "$app/." "$copy/"
  if ! (
    set -a
    # The runtime settings file, written by Ansible from the owner's environment; its path is a variable.
    # shellcheck source=/dev/null
    . "$file"
    set +a
    # fill NAME required|optional VALUE: sets NAME's value in the config copy. The computed settings
    # are passed as values, not as shell variables, so the operator key never enters the environment
    # of the commands this subshell starts.
    fill() {
      local name="$1" required="$2" value="${3:-}"
      if [ -z "$value" ]; then
        [ "$required" = required ] && { echo "secbot-release: runtime setting $name is empty in $file" >&2; return 1; }
        return 0
      fi
      if ! [[ "$value" =~ ^[A-Za-z0-9._@:,+/=-]+$ ]]; then
        echo "secbot-release: runtime setting $name has characters the config cannot carry" >&2
        return 1
      fi
      if ! grep -q "\"$name\": \"\"" "$copy/wrangler.jsonc"; then
        # An older bundle that does not declare an optional var keeps its config unchanged.
        [ "$required" = required ] && { echo "secbot-release: the bundle's config does not declare $name" >&2; return 1; }
        return 0
      fi
      sed -i "s|\"$name\": \"\"|\"$name\": \"$value\"|" "$copy/wrangler.jsonc"
    }
    for name in $RUNTIME_VARS; do fill "$name" required "${!name:-}" || exit 1; done
    for name in $OPTIONAL_RUNTIME_VARS; do fill "$name" optional "${!name:-}" || exit 1; done
    fill SECBOT_OPERATOR_KEY optional "$(cat "$key_file")" || exit 1
    fill SECBOT_FLEET_CELLS optional "$fleet_cells_value" || exit 1
    fill SECBOT_HOUSEHOLD_URL optional "$household_url" || exit 1
    fill SECBOT_SECRETS_URL optional "$secrets_url" || exit 1
    fill SECBOT_KEY_HELPER_URL optional "${serves_secrets:+${SECBOT_KEY_HELPER_URL:-}}" || exit 1
  ); then
    rm -rf "$copy"
    exit 1
  fi
  echo "$copy"
}

# ---- the release store and deploys --------------------------------------------------------------

staged_bundle() {
  local file="$RELEASES/$1.tar.gz"
  [ -f "$file" ] || die "version $1 is not staged"
  local recorded actual
  recorded="$(cat "$RELEASES/$1.sha256")"
  actual="$(sha256sum "$file" | cut -d' ' -f1)"
  [ "$actual" = "$recorded" ] || die "staged bundle $1 no longer matches its recorded SHA-256"
  if [ -n "$sha256" ] && [ "$sha256" != "$recorded" ]; then
    die "SHA-256 mismatch for $1: requested $sha256, staged $recorded"
  fi
  echo "$file"
}

contract_step() { grep -o '"contractStep": *[0-9]*' "$1" | grep -o '[0-9]*$' || echo 0; }

# The SHA-256 a version was first staged with, kept after its bundle is pruned.
known_sha() {
  if [ -f "$KNOWN" ]; then awk -v v="$1" '$1 == v { print $2; exit }' "$KNOWN" || true; fi
}

do_stage() {
  if ! { [ -n "$version" ] && [ -n "$sha256" ]; }; then die "stage needs --version and --sha256"; fi
  with_lock
  # A version is staged once: a second stage of it must carry the same bundle. Without this, the
  # test-cell key could replace a bundle that a production deploy or rollback later trusts.
  local known
  known="$(known_sha "$version")"
  if [ -n "$known" ] && [ "$known" != "$sha256" ]; then
    die "version $version was staged with SHA-256 $known; a version is never restaged with other content"
  fi
  if [ -n "$known" ] && [ -f "$RELEASES/$version.tar.gz" ]; then
    echo "staged $version ($sha256), already present"
    return 0
  fi
  local partial="$RELEASES/.$version.partial"
  # One byte over the cap shows the upload was cut off.
  head -c "$((MAX_BUNDLE_BYTES + 1))" >"$partial"
  if [ "$(stat -c %s "$partial")" -gt "$MAX_BUNDLE_BYTES" ]; then
    rm -f "$partial"
    die "the bundle is over $MAX_BUNDLE_BYTES bytes"
  fi
  local actual
  actual="$(sha256sum "$partial" | cut -d' ' -f1)"
  if [ "$actual" != "$sha256" ]; then
    rm -f "$partial"
    die "SHA-256 mismatch: received $actual, expected $sha256"
  fi
  mv -f "$partial" "$RELEASES/$version.tar.gz"
  echo "$sha256" >"$RELEASES/$version.sha256"
  [ -n "$known" ] || echo "$version $sha256" >>"$KNOWN"
  # Keep the newest $KEEP bundles; a deployed version is never removed.
  local deployed
  deployed="$(readlink -f "$DEPLOYS"/*/current 2>/dev/null | xargs -r -n1 basename || true)"
  # Newest first by modification time (ties by name, as ls -t does); find prints the time with the path.
  find "$RELEASES" -maxdepth 1 -name '*.tar.gz' ! -name '.*' -printf '%T@ %p\n' |
    sort -t ' ' -k1,1nr -k2 | cut -d ' ' -f2- | tail -n +$((KEEP + 1)) | while IFS= read -r old; do
    local name
    name="$(basename "$old" .tar.gz)"
    grep -qx "$name" <<<"$deployed" || rm -f "$old" "$RELEASES/$name.sha256"
  done
  echo "staged $version ($sha256)"
}

# Deletes the production snapshot copies a drill put in the test bucket (celld v0.6.1 `r2 delete`).
delete_drill_objects() {
  [ -s "$DRILL_OBJECTS" ] || return 0
  local keys
  keys="$(sort -u "$DRILL_OBJECTS" | tr '\n' ' ')"
  # shellcheck disable=SC2086 # keys are checked snapshot paths, one word each
  ( fleet_file test
    celld r2 delete "$SNAPSHOT_BUCKET" $keys \
      --bucket "$CELLD_BUCKET" --endpoint "$CELLD_ENDPOINT" --region auto >/dev/null ) ||
    { echo "secbot-release: could not delete the drill's snapshot copies from the test bucket" >&2; return 1; }
  rm -f "$DRILL_OBJECTS"
}

# Wipes the test cell's cells that a restore drill filled with real data, before a test deploy.
wipe_drill_data() {
  delete_drill_objects || die "the drill's snapshot copies are still in the test bucket"
  [ -s "$DRILL_DIRTY" ] || return 0
  local dirty
  dirty="$(sort -u "$DRILL_DIRTY" | paste -sd, -)"
  ops_call test POST "/ops/wipe?cells=$dirty" >/dev/null || die "could not wipe the drill data ($dirty) from the test cell"
  rm -f "$DRILL_DIRTY"
  echo "drill data wiped: $dirty"
}

deploy_fleet() {
  local fleet="$1" bundle="$2" target_env
  target_env="$(env_of_fleet "$fleet")"
  local unit="celld@$fleet"
  systemctl is-active --quiet "$unit" ||
    die "$unit is not running; host setup enables it after the bucket smoke test passes"
  local base dir
  base="$(fleet_dir "$fleet")"
  dir="$base/$version"
  rm -rf "$dir"
  mkdir -p "$dir"
  tar -xzf "$bundle" -C "$dir"
  local current="$base/current"
  if [ -e "$current/manifest.json" ]; then
    local from to
    from="$(contract_step "$current/manifest.json")"
    to="$(contract_step "$dir/manifest.json")"
    [ "$to" -ge "$from" ] || die "refusing a downgrade past contract step $from (bundle $version has step $to)"
    echo "manifest diff against the deployed bundle of $fleet:"
    diff <(grep -o '"path": *"[^"]*"\|"sha256": *"[^"]*"' "$current/manifest.json") \
      <(grep -o '"path": *"[^"]*"\|"sha256": *"[^"]*"' "$dir/manifest.json") || true
  else
    echo "first deploy to $fleet"
  fi
  [ "$fleet" = test ] && wipe_drill_data
  local app="$dir/worker"
  [ "$fleet" = test ] && app="$dir/conformance"
  local rendered
  rendered="$(render_app "$target_env" "$fleet" "$app")"
  trap 'rm -rf "$rendered"' EXIT
  (
    fleet_file "$fleet"
    celld deploy "$rendered" --bucket "$CELLD_BUCKET" --endpoint "$CELLD_ENDPOINT" --region auto
  )
  rm -rf "$rendered"
  trap - EXIT
  ln -sfn "$dir" "$current"
  echo "deployed $version to $fleet ($(fleet_cells "$fleet"))"
}

ledger_append() {
  # $1: a JSON object. Only the production caller writes the ledger.
  [ "$caller" = deploy ] || return 0
  [ -w "$LEDGER" ] || die "the deploy ledger $LEDGER is not writable"
  echo "$1" >>"$LEDGER"
  mirror_ledger
}

# Copies the ledger to the production bucket, so a lost VPS disk does not lose it.
mirror_ledger() {
  ( fleet_file prod-owner
    celld r2 put "$SNAPSHOT_BUCKET" ledger/ledger.jsonl --path "$LEDGER" \
      --bucket "$CELLD_BUCKET" --endpoint "$CELLD_ENDPOINT" --region auto >/dev/null 2>&1 ) ||
    echo "secbot-release: ledger mirror to the bucket failed; the VPS copy is intact" >&2
}

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# The SHA-256 of the newest production deploy of a version in the ledger, or nothing.
ledger_sha() {
  [ -f "$LEDGER" ] || return 0
  grep -F "\"kind\":\"deploy\",\"version\":\"$1\",\"sha256\":\"" "$LEDGER" | tail -n 1 |
    grep -o '"sha256":"[0-9a-f]\{64\}"' | grep -o '[0-9a-f]\{64\}' || true
}

do_deploy() {
  if ! { [ -n "$env" ] && [ -n "$version" ]; }; then die "deploy needs --env and --version"; fi
  local named=""
  if [ -n "$cells" ]; then
    named="$(normalized_cells "$cells")"
    [ -n "$named" ] || { echo "deploy: no cell to deploy"; return 0; }
  fi
  with_lock
  if [ "$env" = production ] && [ -z "$sha256" ]; then
    # A rollback names no hash: it trusts only the hash the production ledger recorded when this
    # version was last deployed to production, never the store the test-cell key can write.
    sha256="$(ledger_sha "$version")"
    [ -n "$sha256" ] || die "a production deploy of $version needs --sha256 (the ledger has no deploy of it with a hash)"
  fi
  local bundle fleets fleet
  bundle="$(staged_bundle "$version")"
  fleets="$(fleets_for "$env" "${named// /,}")"
  for fleet in $fleets; do deploy_fleet "$fleet" "$bundle"; done
  if [ "$env" = production ]; then
    ledger_append "{\"kind\":\"deploy\",\"version\":\"$version\",\"sha256\":\"$sha256\",\"cells\":\"${named// /,}\",\"fleets\":\"${fleets// /,}\",\"runId\":\"$run_id\",\"runAttempt\":\"$run_attempt\",\"at\":\"$(now_iso)\"}"
  fi
}

do_conformance() {
  [ -n "$version" ] || die "conformance needs --version"
  with_lock
  env="test-cell"
  deploy_fleet test "$(staged_bundle "$version")" >&2
  local base
  base="http://$(listen_of test)"
  if [ "$long_transaction" = 1 ]; then
    local first
    first="$(curl -sS --max-time 120 -X POST "$base/conformance/long-transaction?ms=31000" || echo '{"error":"the request ended with the cell reset"}')"
    local marker
    marker="$(curl -sS --fail --max-time 60 "$base/conformance/marker")"
    printf '{"longTransaction":%s,"after":%s}\n' "$first" "$marker"
  else
    curl -sS --fail --max-time 3600 -X POST "$base/conformance/run"
    echo
  fi
}

do_manifest() {
  [ -n "$env" ] || die "manifest needs --env"
  local fleet file
  for fleet in $(fleets_of_env "$env"); do
    file="$(fleet_dir "$fleet")/current/manifest.json"
    [ -f "$file" ] || die "nothing deployed to $fleet"
    cat "$file"
  done
}

# Merges the per-fleet JSON answers {"version":..,"cells":{..}} into one {"version","cells"}.
merge_cells() {
  local first=1 version_field=""
  printf '{"cells":{'
  while IFS= read -r answer; do
    [ -n "$answer" ] || continue
    [ -n "$version_field" ] || version_field="$(grep -o '"version":"[^"]*"' <<<"$answer" | head -n1 || true)"
    local inner
    inner="$(sed -n 's/.*"cells":{\(.*\)}}[[:space:]]*$/\1/p' <<<"$answer")"
    [ -n "$inner" ] || continue
    [ "$first" = 1 ] || printf ','
    printf '%s' "$inner"
    first=0
  done
  printf '}%s}\n' "${version_field:+,$version_field}"
}

per_fleet_get() {
  local path="$1" query fleet list
  for fleet in $(fleets_for "$env" "$cells"); do
    list="$(cells_in_fleet "$fleet" "$cells")"
    [ -n "$list" ] || continue
    query="$path?cells=$list"
    curl -sS --fail --max-time 120 "http://$(listen_of "$fleet")$query"
    echo
  done
}

do_health() {
  [ -n "$env" ] || die "health needs --env"
  if [ -z "$cells" ]; then
    curl -sS --fail --max-time 120 "http://$(listen_of "$(fleets_of_env "$env" | cut -d' ' -f1)")/health"
    echo
    return
  fi
  per_fleet_get /health | merge_cells
}

do_alarms() {
  [ -n "$env" ] || die "alarms needs --env"
  per_fleet_get /alarms | merge_cells
}

do_heartbeats() {
  if [ -z "$env" ]; then
    # The SSH user picks the environment: the test cell for deploy-test, production for deploy.
    [ "$caller" = deploy-test ] && env=test-cell || env=production
  fi
  local fleet list deployed
  {
    for fleet in $(fleets_for "$env" "$cells"); do
      list="$(data_cells_in_fleet "$fleet" "$cells")"
      [ -n "$list" ] || continue
      deployed="$(stat -c %Y "$(fleet_dir "$fleet")/current" 2>/dev/null || echo 0)"
      ops_call "$fleet" GET "/ops/heartbeats?cells=$list" |
        sed "s/\"lastHttpStatus\"/\"deployedAt\":${deployed}000,\"lastHttpStatus\"/g"
    done
  } | merge_cells | sed "s/^{/{\"env\":\"$env\",/"
}

do_snapshot() {
  if ! { [ -n "$env" ] && [ -n "$snapshot_id" ]; }; then die "snapshot needs --env and --snapshot-id"; fi
  with_lock
  local fleet first=1 answer contract=""
  # The secrets cell is never snapshotted: its records are rebuilt and their credentials rotated.
  echo "cell secrets skipped: the secrets cell is never snapshotted" >&2
  printf '{"id":"%s","snapshots":[' "$snapshot_id"
  for fleet in $(fleets_of_env "$env"); do
    answer="$(ops_call "$fleet" POST "/ops/snapshot?id=$snapshot_id")" || die "snapshot of $fleet failed"
    [ -n "$contract" ] || contract="$(grep -o '"contractStep":[0-9]*' <<<"$answer" | head -n1 | cut -d: -f2)"
    [ "$first" = 1 ] || printf ','
    sed -n 's/.*"snapshots":\[\(.*\)\].*/\1/p' <<<"$answer" | tr -d '\n'
    first=0
  done
  printf '],"contractStep":%s}\n' "${contract:-0}"
}

do_restore() {
  if ! { [ -n "$env" ] && [ -n "$cells" ] && [ -n "$snapshot_id" ]; }; then
    die "restore needs --env, --cells, and --snapshot"
  fi
  [[ ",$cells," == *",secrets,"* ]] && die "the secrets cell is never restored: rebuild it and rotate its credentials"
  local cell fleet
  cell="$(normalized_cells "$cells")"
  [[ "$cell" =~ ^[a-z]+$ ]] || die "restore takes exactly one cell"
  fleet="$(fleet_of_cell "$env" "$cell")" || die "no fleet of $env serves cell '$cell'"
  with_lock
  ops_call "$fleet" POST "/ops/restore?id=$snapshot_id&cell=$cell"
}

do_digest() {
  [ -n "$env" ] || die "digest needs --env"
  local fleet list
  for fleet in $(fleets_for "$env" "$cells"); do
    list="$(data_cells_in_fleet "$fleet" "$cells")"
    [ -n "$list" ] || continue
    ops_call "$fleet" GET "/ops/digest?cells=$list"
  done | merge_cells
}

# The newest release snapshot id in the ledger.
newest_snapshot() {
  grep '"kind":"release"' "$LEDGER" 2>/dev/null | grep -o '"snapshotId":"[^"]*"' | tail -n1 | cut -d'"' -f4
}

do_drill() {
  [ "$caller" = deploy ] || die "drill needs the production caller: it reads a production snapshot"
  env=test-cell
  [ -n "$snapshot_id" ] || snapshot_id="$(newest_snapshot)"
  [ -n "$snapshot_id" ] || die "no release snapshot in the deploy ledger; pass --snapshot"
  with_lock
  local cell source copy first=1 restored
  printf '{"snapshot":"%s","restored":[' "$snapshot_id"
  for cell in $(normalized_cells "${cells:-owner}"); do
    source="$(fleet_of_cell production "$cell")" || die "no production fleet serves cell '$cell'"
    copy="$(mktemp)"
    ( fleet_file "$source"
      celld r2 get "$SNAPSHOT_BUCKET" "snapshots/$snapshot_id/$cell.json" \
        --bucket "$CELLD_BUCKET" --endpoint "$CELLD_ENDPOINT" --region auto >"$copy" ) ||
      { rm -f "$copy"; die "snapshot $snapshot_id not found for cell $cell"; }
    # Marked before the copy and the restore, so a failed drill is still cleaned by the next test
    # deploy: the copy is deleted from the test bucket and the cell is wiped.
    echo "snapshots/$snapshot_id/$cell.json" >>"$DRILL_OBJECTS"
    echo "$cell" >>"$DRILL_DIRTY"
    ( fleet_file test
      celld r2 put "$SNAPSHOT_BUCKET" "snapshots/$snapshot_id/$cell.json" --path "$copy" \
        --content-type application/json \
        --bucket "$CELLD_BUCKET" --endpoint "$CELLD_ENDPOINT" --region auto >/dev/null )
    rm -f "$copy"
    restored="$(ops_call test POST "/ops/restore?id=$snapshot_id&cell=$cell")" || die "the drill restore of $cell failed"
    # The cell holds the data now; the production copy leaves the test bucket at once.
    delete_drill_objects || die "the drill's snapshot copy of $cell is still in the test bucket"
    [ "$first" = 1 ] || printf ','
    printf '%s' "$(tr -d '\n' <<<"$restored")"
    first=0
  done
  printf ']}\n'
}

do_ledger_record() {
  [ "$caller" = deploy ] || die "only the production caller records in the deploy ledger"
  [ -n "$kind" ] || die "ledger-record needs --kind"
  with_lock
  ledger_append "{\"kind\":\"$kind\",\"version\":\"$version\",\"cells\":\"$cells\",\"snapshotId\":\"$snapshot_id\",\"runId\":\"$run_id\",\"runAttempt\":\"$run_attempt\",\"at\":\"$(now_iso)\"}"
  echo "ledger: recorded $kind${version:+ $version}${run_id:+ run $run_id attempt $run_attempt}"
}

do_ledger_read() {
  [ -r "$LEDGER" ] || die "the deploy ledger is not readable here"
  tail -n 500 "$LEDGER"
}

do_state() {
  [ -n "$env" ] || die "state needs --env"
  local fleet first=1 port
  printf '{"fleets":{'
  for fleet in $(fleets_of_env "$env"); do
    [ -r "/etc/secbot/fleet-$fleet.env" ] || continue
    systemctl is-active --quiet "celld@$fleet" || continue
    port="$( (fleet_file "$fleet"; echo "$CELLD_INTERNAL_PORT") )"
    [ "$first" = 1 ] || printf ','
    printf '"%s":%s' "$fleet" "$(curl -sS --fail --max-time 10 "http://127.0.0.1:$port/state")"
    first=0
  done
  printf '}}\n'
}

do_write_delay() {
  test_cell_only
  local count="${writes:-200}" warmup=10 n first=1 ms
  if ! { [ "$count" -ge 1 ] && [ "$count" -le 2000 ]; }; then die "write-delay needs --writes 1-2000"; fi
  with_lock
  local header base
  header="$(operator_header test-cell)"
  base="http://$(listen_of test)"
  printf '{"warmup":%s,"ms":[' "$warmup"
  for n in $(seq 1 $((count + warmup))); do
    # Each request commits one row; celld answers after the write is durable in the bucket.
    ms="$(curl -sS --fail --max-time 60 -o /dev/null -w '%{time_total}' -X POST -H "@$header" "$base/ops/write")" ||
      { rm -f "$header"; die "write $n failed"; }
    [ "$n" -le "$warmup" ] && continue
    [ "$first" = 1 ] || printf ','
    awk -v t="$ms" 'BEGIN { printf "%.1f", t * 1000 }'
    first=0
  done
  rm -f "$header"
  printf ']}\n'
}

test_cell_only() {
  [ "$env" = "test-cell" ] || die "$command runs only with --env test-cell"
}

# Waits until the test cell answers /health again; prints the seconds it took.
wait_for_test_cell() {
  local started now listen
  listen="$(listen_of test)"
  started="$(date +%s)"
  for _ in $(seq 1 120); do
    if curl -sS --fail --max-time 5 "http://$listen/health" >/dev/null 2>&1; then
      now="$(date +%s)"
      echo $((now - started))
      return 0
    fi
    sleep 1
  done
  die "celld@test did not answer within 120 s"
}

do_lab() {
  test_cell_only
  [ -n "$lab_route" ] || die "lab needs --route"
  with_lock
  local method=POST path="/lab/$lab_route"
  case "$lab_route" in
    state | alarm-report) method=GET ;;
    load-state) method=GET path=/lab/load ;;
    # The guard bench: the cell measures in the background; the client polls guard-bench-state.
    guard-bench)
      if [ "$examples" = 1 ]; then
        path="/lab/guard-bench?examples=1&repeat=${repeat:-2}${adapter:+&adapter=$adapter}"
      else
        path="/lab/guard-bench?calls=${calls:-100}${adapter:+&adapter=$adapter}"
      fi
      ;;
    guard-bench-state) method=GET ;;
    alarm)
      [ -n "$at" ] || die "lab --route alarm needs --at <epoch ms>|none"
      path="/lab/alarm?set=$at"
      ;;
  esac
  # The guard bench starts paid model calls, so the worker asks for the operator key there.
  local header=""
  case "$lab_route" in
    guard-bench | guard-bench-state) header="$(operator_header "$(env_of_fleet test)")" ;;
  esac
  local status=0
  curl -sS --fail --max-time 120 -X "$method" ${header:+-H "@$header"} "http://$(listen_of test)$path" || status=$?
  [ -z "$header" ] || rm -f "$header"
  echo
  return "$status"
}

do_crash() {
  test_cell_only
  with_lock
  sudo -n /usr/bin/systemctl kill -s KILL celld@test
  sleep 2
  echo "killed celld@test with SIGKILL; it answered again after $(wait_for_test_cell) s" >&2
}

do_down() {
  test_cell_only
  if ! { [ -n "$seconds" ] && [ "$seconds" -ge 1 ] && [ "$seconds" -le 600 ]; }; then die "down needs --seconds 1-600"; fi
  with_lock
  local from up
  from="$(date +%s%3N)"
  sudo -n /usr/bin/systemctl stop celld@test
  sleep "$seconds"
  sudo -n /usr/bin/systemctl start celld@test
  wait_for_test_cell >/dev/null
  up="$(date +%s%3N)"
  printf '{"downFrom":%s,"upAt":%s}\n' "$from" "$up"
}

case "$command" in
  stage) do_stage ;;
  deploy) do_deploy ;;
  conformance) do_conformance ;;
  manifest) do_manifest ;;
  health) do_health ;;
  alarms) do_alarms ;;
  heartbeats) do_heartbeats ;;
  snapshot) do_snapshot ;;
  restore) do_restore ;;
  digest) do_digest ;;
  drill) do_drill ;;
  ledger-record) do_ledger_record ;;
  ledger-read) do_ledger_read ;;
  lease) do_lease ;;
  state) do_state ;;
  write-delay) do_write_delay ;;
  lab) do_lab ;;
  crash) do_crash ;;
  down) do_down ;;
  tool-sha) sha256sum "$0" | cut -d' ' -f1 ;;
  *) die "unknown command '$command'; expected tool-sha, stage, deploy, conformance, manifest, health, alarms, heartbeats, snapshot, restore, digest, drill, ledger-record, ledger-read, lease, state, write-delay, lab, crash, or down" ;;
esac
