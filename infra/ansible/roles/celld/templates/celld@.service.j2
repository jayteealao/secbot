# Managed by Ansible (infra/ansible/roles/celld). One instance per fleet: celld@test, celld@prod-owner, celld@prod-shared.
[Unit]
Description=celld cells (%i)
After=network-online.target tailscaled.service
Wants=network-online.target
# Unlimited restarts: never give up on the cells.
StartLimitIntervalSec=0

[Service]
Type=simple
User=celld
Group=celld
EnvironmentFile=/etc/secbot/celld-%i.env
StateDirectory=celld/%i
WorkingDirectory=/var/lib/celld/%i
Environment=CELLD_WATCH=/var/lib/celld/%i
# celld's own lines at warn and above, every cell line (target cell_console) at info; the filter
# is set here, not in the env file, so the release tool's celld commands keep their output.
Environment=RUST_LOG={{ celld_log_filter }}
# The cells log to their own journal, kept apart from the system journal:
# sudo journalctl --namespace={{ celld_log_namespace }} -u celld@%i
LogNamespace={{ celld_log_namespace }}
# The worker listens on the private-network address only; the internal listener stays on loopback.
ExecStart=/usr/local/bin/celld \
  --bucket ${CELLD_BUCKET} \
  --endpoint ${CELLD_ENDPOINT} \
  --region auto \
  --listen ${CELLD_LISTEN} \
  --internal-listen 127.0.0.1:${CELLD_INTERNAL_PORT} \
  --advertise 127.0.0.1:${CELLD_INTERNAL_PORT}
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# The VPS runs other software: one fleet's overrun stops that fleet only (systemd restarts it),
# never its neighbours. Sizes are in roles/celld/defaults/main.yml; raise them with the heap
# measurement (mise run measure:heap).
MemoryHigh={{ celld_memory_high }}
MemoryMax={{ celld_memory_max }}
TasksMax={{ celld_tasks_max }}
LimitNOFILE={{ celld_nofile }}
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
