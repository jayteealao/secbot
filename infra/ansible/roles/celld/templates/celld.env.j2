# Managed by Ansible. Values come from the owner's shell at setup time, never from the repo.
# A key prefix lets two fleets share one bucket (celld v0.6.1 docs/README.md:267-270).
CELLD_BUCKET=s3://{{ lookup('ansible.builtin.env', item.bucket_env) }}{{ ('/' + item.prefix) if item.prefix else '' }}
CELLD_ENDPOINT={{ lookup('ansible.builtin.env', 'SECBOT_R2_ENDPOINT') }}
CELLD_LISTEN={{ celld_private_address }}:{{ celld_ports[item.name].worker }}
CELLD_INTERNAL_PORT={{ celld_ports[item.name].internal }}
CELLD_V8_HEAP_LIMIT_MB={{ celld_v8_heap_limit_mb }}
AWS_ACCESS_KEY_ID={{ lookup('ansible.builtin.env', item.access_key_env) }}
AWS_SECRET_ACCESS_KEY={{ lookup('ansible.builtin.env', item.secret_key_env) }}
{% if item.heartbeat_env is defined %}
SECBOT_HEARTBEAT_URL={{ lookup('ansible.builtin.env', item.heartbeat_env) }}
{% endif %}
