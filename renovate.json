{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "enabledManagers": ["npm", "gradle", "gradle-wrapper", "github-actions", "mise", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "celld release pin used by the VPS host setup",
      "managerFilePatterns": ["/^infra/ansible/roles/celld/defaults/main\\.yml$/"],
      "matchStrings": ["celld_version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "denoland/celld",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "labels": ["deps"],
  "packageRules": [
    {
      "description": "Private pi-durable and celld forks: one PR per fork tag bump; the test cell gates the release",
      "matchPackageNames": ["/pi-durable/", "/celld/"],
      "automerge": false,
      "labels": ["deps", "fork-sync"]
    }
  ]
}
